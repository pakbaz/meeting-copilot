@using MeetingCopilot.Contracts.Entities

<div class="agenda-editor">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <label class="form-label mb-0">Meeting Agenda</label>
        <button type="button" class="btn btn-sm btn-primary" @onclick="AddAgendaItem">
            <i class="bi bi-plus-lg"></i> Add Item
        </button>
    </div>
    
    @if (AgendaItems == null || AgendaItems.Count == 0)
    {
        <div class="text-muted small">No agenda items yet. Click "Add Item" to create one.</div>
    }
    else
    {
        <div class="agenda-items">
            @foreach (var (item, index) in AgendaItems.Select((item, i) => (item, i)))
            {
                <div class="agenda-item mb-2" key="@item.Id">
                    <div class="input-group">
                        <span class="input-group-text">@(index + 1).</span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Agenda item title"
                               value="@item.Title"
                               @onchange="@(e => UpdateItemTitle(item.Id, e.Value?.ToString() ?? ""))" />
                        <button type="button" 
                                class="btn btn-outline-secondary"
                                @onclick="@(() => MoveUp(index))"
                                disabled="@(index == 0)">
                            <i class="bi bi-arrow-up"></i>
                        </button>
                        <button type="button" 
                                class="btn btn-outline-secondary"
                                @onclick="@(() => MoveDown(index))"
                                disabled="@(index == AgendaItems.Count - 1)">
                            <i class="bi bi-arrow-down"></i>
                        </button>
                        <button type="button" 
                                class="btn btn-outline-danger"
                                @onclick="@(() => RemoveItem(item.Id))">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<AgendaItem> AgendaItems { get; set; } = new();
    [Parameter] public EventCallback<List<AgendaItem>> AgendaItemsChanged { get; set; }

    private void AddAgendaItem()
    {
        var newItem = new AgendaItem
        {
            Id = Guid.NewGuid().ToString(),
            Title = "",
            Order = AgendaItems.Count,
            Status = AgendaItemStatus.Pending
        };
        
        AgendaItems.Add(newItem);
        _ = NotifyChanged();
    }

    private void UpdateItemTitle(string itemId, string newTitle)
    {
        var item = AgendaItems.FirstOrDefault(i => i.Id == itemId);
        if (item != null)
        {
            var index = AgendaItems.IndexOf(item);
            AgendaItems[index] = item with { Title = newTitle };
            _ = NotifyChanged();
        }
    }

    private void RemoveItem(string itemId)
    {
        var item = AgendaItems.FirstOrDefault(i => i.Id == itemId);
        if (item != null)
        {
            AgendaItems.Remove(item);
            ReorderItems();
            _ = NotifyChanged();
        }
    }

    private void MoveUp(int index)
    {
        if (index > 0)
        {
            var item = AgendaItems[index];
            AgendaItems.RemoveAt(index);
            AgendaItems.Insert(index - 1, item);
            ReorderItems();
            _ = NotifyChanged();
        }
    }

    private void MoveDown(int index)
    {
        if (index < AgendaItems.Count - 1)
        {
            var item = AgendaItems[index];
            AgendaItems.RemoveAt(index);
            AgendaItems.Insert(index + 1, item);
            ReorderItems();
            _ = NotifyChanged();
        }
    }

    private void ReorderItems()
    {
        for (int i = 0; i < AgendaItems.Count; i++)
        {
            AgendaItems[i] = AgendaItems[i] with { Order = i };
        }
    }

    private async Task NotifyChanged()
    {
        await AgendaItemsChanged.InvokeAsync(AgendaItems);
    }
}
