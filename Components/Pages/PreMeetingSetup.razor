@page "/meeting/setup"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ILogger<PreMeetingSetup> Logger
@using MeetingCopilot.Contracts.Entities
@using meeting_copilot.Services

<PageTitle>Pre-Meeting Setup - Meeting Copilot</PageTitle>

<div class="pre-meeting-container d-flex justify-content-center align-items-center vh-100">
    <div class="setup-card" style="width: 500px; max-width: 90%;">
        <div class="card border">
            <div class="card-body p-4">
                <EditForm Model="@setupModel" OnValidSubmit="HandleStartMeeting">
                    <DataAnnotationsValidator />

                    <!-- Meeting Context Area (Title, Agenda, Attendees, Goals) -->
                    <div class="mb-4">
                        <InputTextArea id="context" 
                                      class="form-control" 
                                      @bind-Value="setupModel.Context" 
                                      rows="10"
                                      placeholder="Meeting Title, Agenda, Attendees, Goals and any relevant Context...." 
                                      style="resize: none; border: 1px solid #ccc;" />
                    </div>

                    <!-- Microphone Selector -->
                    <div class="mb-4">
                        <MicrophoneSelector SelectedDeviceId="@setupModel.MicrophoneDeviceId" 
                                          SelectedDeviceIdChanged="@OnMicrophoneDeviceChanged" />
                    </div>

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2" role="alert">
                            @errorMessage
                        </div>
                    }

                    <!-- Start Meeting Button -->
                    <div class="d-grid">
                        <button type="submit" 
                                class="btn btn-dark btn-lg"
                                disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Starting...</span>
                            }
                            else
                            {
                                <span>Start Meeting</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<style>
    .pre-meeting-container {
        background-color: #f5f5f5;
    }
    
    .setup-card .form-control:focus {
        border-color: #333;
        box-shadow: none;
    }
</style>

@code {
    private PreMeetingSetupModel setupModel = new();
    private bool isSubmitting = false;
    private string? errorMessage;

    [Inject] private MeetingService MeetingService { get; set; } = default!;
    [Inject] private MeetingContextExtractor? ContextExtractor { get; set; }

    protected override void OnInitialized()
    {
        // Pre-populate with sample data for testing
        setupModel.Context = @"Weekly Product Sync Meeting

## Attendees
- John Smith (Product Manager)
- Sarah Johnson (Engineering Lead)
- Mike Chen (Designer)

## Agenda
1. Review last week's action items
2. Discuss Q1 roadmap progress
3. Demo new feature mockups
4. Sprint planning for next week
5. Open discussion / Q&A

## Goals
- Align on Q1 priorities
- Get feedback on new designs
- Assign owners for upcoming tasks";
    }

    private async Task HandleStartMeeting()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            string title;
            string description;
            List<AgendaItem> agendaItems;

            // Use LLM extraction if available, otherwise fall back to regex parsing
            if (ContextExtractor != null && !string.IsNullOrWhiteSpace(setupModel.Context))
            {
                Logger.LogInformation("Using LLM to extract meeting details...");
                var extracted = await ContextExtractor.ExtractMeetingDetailsAsync(setupModel.Context);
                
                title = extracted.Title;
                description = extracted.Description ?? setupModel.Context ?? "";
                agendaItems = extracted.AgendaItems.Select((item, index) => new AgendaItem
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = item,
                    Order = index + 1,
                    Status = AgendaItemStatus.Pending
                }).ToList();

                Logger.LogInformation("LLM extracted: Title='{Title}', {Count} agenda items", title, agendaItems.Count);
            }
            else
            {
                // Fallback to regex-based parsing
                (title, description, agendaItems) = ParseMeetingContext(setupModel.Context);
            }

            // Create meeting (using default user for MVP single-user mode)
            var meeting = await MeetingService.CreateMeetingAsync(
                userId: "default-user",
                title: title,
                description: description,
                agendaItems: agendaItems,
                microphoneDeviceId: setupModel.MicrophoneDeviceId,
                language: "en-US"
            );

            if (meeting != null)
            {
                // Start the meeting
                await MeetingService.StartMeetingAsync(meeting.Id);
                
                // Navigate to in-meeting view
                Navigation.NavigateTo($"/meeting/{meeting.Id}");
            }
            else
            {
                errorMessage = "Failed to create meeting. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting meeting");
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private (string title, string description, List<AgendaItem> agendaItems) ParseMeetingContext(string? context)
    {
        if (string.IsNullOrWhiteSpace(context))
        {
            return ("Untitled Meeting", "", new List<AgendaItem>());
        }

        var lines = context.Split('\n');
        var title = "Untitled Meeting";
        var descriptionLines = new List<string>();
        var agendaItems = new List<AgendaItem>();
        var inAgendaSection = false;
        var order = 0;

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();
            
            // First non-empty line is the title
            if (title == "Untitled Meeting" && !string.IsNullOrWhiteSpace(line) && !line.StartsWith("#"))
            {
                title = line;
                continue;
            }

            // Check for agenda section header
            if (line.StartsWith("## Agenda") || line.StartsWith("# Agenda") || 
                line.ToLower().Contains("agenda:") || line.ToLower() == "agenda")
            {
                inAgendaSection = true;
                continue;
            }

            // Check for other section headers (end of agenda section)
            if (inAgendaSection && (line.StartsWith("## ") || line.StartsWith("# ")))
            {
                inAgendaSection = false;
            }

            // Parse agenda items
            if (inAgendaSection && !string.IsNullOrWhiteSpace(line))
            {
                // Match numbered items like "1. Item" or "1) Item" or bullet points "- Item" or "* Item"
                var agendaMatch = System.Text.RegularExpressions.Regex.Match(line, @"^(?:\d+[\.\)]\s*|[-*]\s*)(.+)$");
                if (agendaMatch.Success)
                {
                    order++;
                    agendaItems.Add(new AgendaItem
                    {
                        Id = Guid.NewGuid().ToString(),
                        Title = agendaMatch.Groups[1].Value.Trim(),
                        Order = order,
                        Status = AgendaItemStatus.Pending
                    });
                    continue;
                }
            }

            // Add to description
            descriptionLines.Add(rawLine);
        }

        var description = string.Join("\n", descriptionLines).Trim();
        
        // If no agenda items were parsed, try to infer from numbered lines anywhere
        if (agendaItems.Count == 0)
        {
            order = 0;
            foreach (var rawLine in lines)
            {
                var line = rawLine.Trim();
                var numberedMatch = System.Text.RegularExpressions.Regex.Match(line, @"^(\d+)[\.\)]\s+(.+)$");
                if (numberedMatch.Success)
                {
                    order++;
                    agendaItems.Add(new AgendaItem
                    {
                        Id = Guid.NewGuid().ToString(),
                        Title = numberedMatch.Groups[2].Value.Trim(),
                        Order = order,
                        Status = AgendaItemStatus.Pending
                    });
                }
            }
        }

        return (title, description, agendaItems);
    }

    private void OnMicrophoneDeviceChanged(string? deviceId)
    {
        setupModel.MicrophoneDeviceId = deviceId;
    }

    public class PreMeetingSetupModel
    {
        public string? Context { get; set; }
        public string? MicrophoneDeviceId { get; set; }
    }
}
