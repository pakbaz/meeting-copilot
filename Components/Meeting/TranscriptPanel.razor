@using MeetingCopilot.Contracts.Entities
@using MeetingCopilot.Contracts.Events
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<div class="transcript-panel">
    <div class="transcript-header d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
            <i class="bi bi-mic-fill"></i> Live Transcript
        </h6>
        <div class="transcript-controls">
            @if (IsRecording)
            {
                <span class="badge bg-danger">
                    <span class="recording-indicator"></span> Recording
                </span>
            }
            else
            {
                <span class="badge bg-secondary">Stopped</span>
            }
        </div>
    </div>

    <div class="transcript-messages" style="max-height: 500px; overflow-y: auto;">
        @if (Transcripts.Count == 0)
        {
            <div class="text-muted text-center py-4">
                <i class="bi bi-mic-mute"></i>
                <p class="mb-0 mt-2">Waiting for speech...</p>
            </div>
        }
        else
        {
            @foreach (var transcript in Transcripts)
            {
                <div class="transcript-item mb-2 p-2 border-start border-3 border-primary">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <SpeakerLabel SpeakerId="@transcript.SpeakerId" DisplayName="@transcript.SpeakerName" />
                        <small class="text-muted">
                            @transcript.Timestamp.ToString("HH:mm:ss")
                        </small>
                    </div>
                    <p class="mb-0">@transcript.Text</p>
                    @if (transcript.Confidence < 0.8)
                    {
                        <small class="text-warning">
                            <i class="bi bi-exclamation-triangle"></i> Low confidence
                        </small>
                    }
                </div>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(CurrentInterimText))
    {
        <div class="interim-text mt-2 p-2 bg-light border rounded">
            <small class="text-muted fst-italic">
                @CurrentInterimText
            </small>
        </div>
    }
</div>

<style>
    .recording-indicator {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: white;
        animation: pulse 1.5s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.3;
        }
    }

    .transcript-item {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .transcript-messages {
        scrollbar-width: thin;
    }

    .transcript-messages::-webkit-scrollbar {
        width: 6px;
    }

    .transcript-messages::-webkit-scrollbar-thumb {
        background-color: #ccc;
        border-radius: 3px;
    }
</style>

@code {
    [Parameter] public string MeetingId { get; set; } = "";
    [Parameter] public bool IsRecording { get; set; }

    private List<TranscriptItem> Transcripts { get; set; } = new();
    private string CurrentInterimText { get; set; } = "";
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await InitializeSignalRConnection();
    }

    private async Task InitializeSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/meeting"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<TranscriptionEvent>("UtteranceTranscribed", OnUtteranceTranscribed);
            _hubConnection.On<string, string>("InterimTranscription", OnInterimTranscription);

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinMeeting", MeetingId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing SignalR connection");
        }
    }

    private void OnUtteranceTranscribed(TranscriptionEvent evt)
    {
        InvokeAsync(() =>
        {
            Transcripts.Add(new TranscriptItem
            {
                SpeakerId = evt.SpeakerId,
                SpeakerName = evt.SpeakerName,
                Text = evt.Text,
                Timestamp = evt.Timestamp,
                Confidence = evt.Confidence
            });

            CurrentInterimText = "";
            StateHasChanged();

            // Auto-scroll to bottom
            _ = ScrollToBottom();
        });
    }

    private void OnInterimTranscription(string speakerId, string text)
    {
        InvokeAsync(() =>
        {
            CurrentInterimText = text;
            StateHasChanged();
        });
    }

    private async Task ScrollToBottom()
    {
        // Would use JSInterop to scroll in production
        await Task.CompletedTask;
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ILogger<TranscriptPanel> Logger { get; set; } = default!;

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class TranscriptItem
    {
        public required string SpeakerId { get; init; }
        public string? SpeakerName { get; init; }
        public required string Text { get; init; }
        public required DateTimeOffset Timestamp { get; init; }
        public double Confidence { get; init; } = 1.0;
    }
}
