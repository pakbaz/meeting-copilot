@using MeetingCopilot.Contracts.Entities

<div class="research-detail-view">
    @if (Research != null)
    {
        <div class="modal-header">
            <h5 class="modal-title">Research Details</h5>
            <button type="button" class="btn-close" @onclick="OnClose"></button>
        </div>
        
        <div class="modal-body">
            <div class="query-section mb-4">
                <h6 class="text-muted mb-2">
                    <i class="bi bi-search"></i> Research Query
                </h6>
                <div class="p-3 bg-light rounded">
                    <p class="mb-0"><strong>@Research.Query</strong></p>
                    <small class="text-muted">
                        Triggered: @Research.TriggerType.ToString() • 
                        @Research.Timestamp.LocalDateTime.ToString("f")
                    </small>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Research.Summary))
            {
                <div class="summary-section mb-4">
                    <h6 class="text-muted mb-2">
                        <i class="bi bi-card-text"></i> Summary
                    </h6>
                    <div class="p-3 border rounded">
                        <p class="mb-0" style="white-space: pre-wrap;">@Research.Summary</p>
                    </div>
                </div>
            }
            
            @if (Research.Results?.Count > 0)
            {
                <div class="results-section">
                    <h6 class="text-muted mb-2">
                        <i class="bi bi-list-check"></i> Results (@Research.Results.Count)
                    </h6>
                    <div class="accordion" id="researchResultsAccordion">
                        @for (int i = 0; i < Research.Results.Count; i++)
                        {
                            var result = Research.Results[i];
                            var collapseId = $"collapse{i}";
                            var headingId = $"heading{i}";
                            
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#@collapseId"
                                            aria-expanded="@(i == 0 ? "true" : "false")" 
                                            aria-controls="@collapseId">
                                        <div class="d-flex align-items-center w-100 me-2">
                                            <span class="text-truncate" style="max-width: 300px;">@result.Title</span>
                                            <span class="badge bg-@GetRelevanceBadgeColor(result.Relevance) ms-2">
                                                @((int)(result.Relevance * 100))% match
                                            </span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="@collapseId" 
                                     class="accordion-collapse collapse @(i == 0 ? "show" : "")" 
                                     aria-labelledby="@headingId"
                                     data-bs-parent="#researchResultsAccordion">
                                    <div class="accordion-body">
                                        <p style="white-space: pre-wrap;">@result.Snippet</p>
                                        @if (!string.IsNullOrEmpty(result.Url))
                                        {
                                            <a href="@result.Url" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                                View Source
                                            </a>
                                        }
                                        <span class="badge bg-secondary ms-2">@result.SourceType</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    No detailed results available for this research query.
                </div>
            }
            
            @if (Research.ProcessingTimeMs > 0)
            {
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-clock-history me-1"></i>
                        Processing time: @Research.ProcessingTimeMs ms
                    </small>
                </div>
            }
        </div>
        
        <div class="modal-footer">
            <div class="d-flex justify-content-between w-100">
                <div>
                    @if (OnRequestMore.HasDelegate)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="RequestMoreResearch">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            Research More
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Close</button>
            </div>
        </div>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-info-circle"></i>
            <p class="mb-0">No research selected</p>
        </div>
    }
</div>

@code {
    [Parameter] public ResearchDetail? Research { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRequestMore { get; set; }

    public enum ResearchTriggerType
    {
        Manual,
        AutoDetect,
        Question
    }

    public record ResearchResultDetail(
        string Title,
        string Snippet,
        string? Url,
        double Relevance,
        string SourceType
    );

    public record ResearchDetail(
        string Id,
        string Query,
        ResearchTriggerType TriggerType,
        string? Summary,
        List<ResearchResultDetail>? Results,
        long ProcessingTimeMs,
        DateTimeOffset Timestamp
    );

    private string GetRelevanceBadgeColor(double relevance)
    {
        return relevance switch
        {
            >= 0.8 => "success",
            >= 0.6 => "warning",
            _ => "secondary"
        };
    }

    private async Task RequestMoreResearch()
    {
        if (Research != null && OnRequestMore.HasDelegate)
        {
            await OnRequestMore.InvokeAsync(Research.Query);
        }
    }
}
