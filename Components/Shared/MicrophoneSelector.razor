@using meeting_copilot.Services
@inject IJSRuntime JS

<div class="microphone-selector">
    <label for="microphone-select" class="form-label">Select Microphone</label>
    
    @if (!HasPermission)
    {
        <div class="d-grid mb-2">
            <button type="button" class="btn btn-outline-primary" @onclick="RequestMicrophonePermission" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                <i class="bi bi-mic me-2"></i>Enable Microphone Access
            </button>
        </div>
    }
    else
    {
        <select id="microphone-select" 
                class="form-select" 
                @bind="SelectedDeviceId" 
                @bind:after="OnDeviceChanged">
            @if (Devices != null && Devices.Count > 0)
            {
                @foreach (var device in Devices)
                {
                    <option value="@device.DeviceId">
                        @(string.IsNullOrEmpty(device.Label) ? $"Microphone {device.DeviceId.Substring(0, 8)}..." : device.Label)
                    </option>
                }
            }
            else if (IsLoading)
            {
                <option value="">Loading devices...</option>
            }
            else
            {
                <option value="">No devices found</option>
            }
        </select>
    }
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-warning mt-2 py-2" role="alert">
            <small>@ErrorMessage</small>
        </div>
    }
</div>

@code {
    [Parameter] public string? SelectedDeviceId { get; set; }
    [Parameter] public EventCallback<string?> SelectedDeviceIdChanged { get; set; }
    
    private List<AudioDevice>? Devices { get; set; }
    private bool IsLoading { get; set; } = false;
    private bool HasPermission { get; set; } = false;
    private string? ErrorMessage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckMicrophonePermission();
        }
    }

    private async Task CheckMicrophonePermission()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();
        
        try
        {
            var result = await JS.InvokeAsync<PermissionResult>("MicrophonePermissions.checkMicrophonePermission");
            HasPermission = result.HasPermission;
            
            if (HasPermission)
            {
                await LoadDevicesAsync();
            }
            else if (!string.IsNullOrEmpty(result.Error))
            {
                ErrorMessage = result.Error;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error checking microphone: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task RequestMicrophonePermission()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();
        
        try
        {
            var result = await JS.InvokeAsync<PermissionResult>("MicrophonePermissions.requestMicrophonePermission");
            
            if (result.Granted)
            {
                HasPermission = true;
                await LoadDevicesAsync();
            }
            else
            {
                ErrorMessage = result.Error ?? "Microphone permission was denied. Please allow microphone access and try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error requesting permission: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            var devices = await JS.InvokeAsync<List<AudioDevice>>("MicrophonePermissions.enumerateAudioDevices");
            Devices = devices?.Where(d => d.Kind == "audioinput").ToList() ?? new List<AudioDevice>();
            
            if (Devices.Count == 0)
            {
                ErrorMessage = "No microphones detected. Please check your system settings.";
            }
            else if (string.IsNullOrEmpty(SelectedDeviceId))
            {
                // Select first device as default
                SelectedDeviceId = Devices.First().DeviceId;
                await SelectedDeviceIdChanged.InvokeAsync(SelectedDeviceId);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading devices: {ex.Message}";
        }
    }

    private async Task OnDeviceChanged()
    {
        await SelectedDeviceIdChanged.InvokeAsync(SelectedDeviceId);
    }

    private class PermissionResult
    {
        public bool HasPermission { get; set; }
        public bool Granted { get; set; }
        public string? Error { get; set; }
    }

    private class AudioDevice
    {
        public string DeviceId { get; set; } = "";
        public string Kind { get; set; } = "";
        public string Label { get; set; } = "";
        public string GroupId { get; set; } = "";
    }
}
