@using MeetingCopilot.Contracts.Entities
@using Microsoft.AspNetCore.SignalR.Client

<div class="key-points-panel">
    <div class="panel-header d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
            <i class="bi bi-lightbulb"></i> Key Points
        </h6>
        <span class="badge bg-primary">@KeyPoints.Count</span>
    </div>

    <div class="key-points-list">
        @if (KeyPoints.Count == 0)
        {
            <div class="text-muted text-center py-3">
                <i class="bi bi-card-list"></i>
                <p class="mb-0 mt-2 small">Key points will appear here as the meeting progresses...</p>
            </div>
        }
        else
        {
            @foreach (var point in TopKeyPoints)
            {
                <div class="key-point-item mb-2 p-2 border rounded @GetPriorityClass(point.PriorityScore)">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="key-point-content flex-grow-1">
                            <strong class="d-block">@point.Title</strong>
                            @if (ExpandedPointId == point.Id)
                            {
                                <p class="mb-1 small text-muted">@point.Content</p>
                            }
                        </div>
                        <div class="key-point-actions d-flex gap-1">
                            <button class="btn btn-sm btn-link p-0" 
                                    @onclick="() => ToggleExpand(point.Id)"
                                    title="@(ExpandedPointId == point.Id ? "Collapse" : "Expand")">
                                <i class="bi @(ExpandedPointId == point.Id ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </button>
                            @if (point.Type != InsightType.ParkingLot)
                            {
                                <button class="btn btn-sm btn-outline-warning follow-up-btn" 
                                        @onclick="() => AddToFollowUp(point)"
                                        title="Add to Parking Lot for follow-up">
                                    <i class="bi bi-flag"></i>
                                    <span class="d-none d-lg-inline ms-1">Follow Up</span>
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark" title="Already in Parking Lot">
                                    <i class="bi bi-flag-fill"></i>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">
                            @point.CreatedAt.LocalDateTime.ToString("HH:mm")
                        </small>
                        <span class="badge @GetTypeBadgeClass(point.Type)">
                            @point.Type.ToString()
                        </span>
                    </div>
                </div>
            }
        }
    </div>

    @if (KeyPoints.Count > 5)
    {
        <div class="text-center mt-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowAllKeyPoints = !ShowAllKeyPoints">
                @(ShowAllKeyPoints ? "Show Top 5" : $"Show All ({KeyPoints.Count})")
            </button>
        </div>
    }

    @if (ParkingLotCount > 0)
    {
        <div class="parking-lot-indicator mt-3 p-2 bg-light rounded d-flex justify-content-between align-items-center">
            <span class="small">
                <i class="bi bi-flag text-warning"></i> 
                @ParkingLotCount item(s) in Parking Lot
            </span>
            <button class="btn btn-sm btn-link p-0" @onclick="OnViewParkingLot">
                View <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    }
</div>

<style>
    .key-point-item {
        transition: all 0.2s ease;
    }
    
    .key-point-item:hover {
        background-color: #f8f9fa;
    }
    
    .key-point-item.high-priority {
        border-left: 3px solid #dc3545 !important;
    }
    
    .key-point-item.medium-priority {
        border-left: 3px solid #ffc107 !important;
    }
    
    .key-point-item.low-priority {
        border-left: 3px solid #6c757d !important;
    }
    
    .follow-up-btn {
        font-size: 0.75rem;
        padding: 0.125rem 0.375rem;
    }
    
    .follow-up-btn:hover {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }
    
    .parking-lot-indicator {
        border: 1px dashed #ffc107;
    }
</style>

@code {
    [Parameter] public List<Insight> KeyPoints { get; set; } = new();
    [Parameter] public EventCallback<Insight> OnAddToParkingLot { get; set; }
    [Parameter] public EventCallback<Insight> OnKeyPointSelected { get; set; }
    [Parameter] public EventCallback OnViewParkingLot { get; set; }

    private string? ExpandedPointId;
    private bool ShowAllKeyPoints = false;

    private int ParkingLotCount => KeyPoints.Count(k => k.Type == InsightType.ParkingLot);

    private IEnumerable<Insight> TopKeyPoints => ShowAllKeyPoints
        ? KeyPoints.OrderByDescending(k => k.PriorityScore ?? 0)
        : KeyPoints.OrderByDescending(k => k.PriorityScore ?? 0).Take(5);

    private void ToggleExpand(string pointId)
    {
        ExpandedPointId = ExpandedPointId == pointId ? null : pointId;
    }

    private async Task AddToFollowUp(Insight point)
    {
        // Create a parking lot version of this insight
        var parkingLotItem = point with
        {
            Id = Guid.NewGuid().ToString(),
            Type = InsightType.ParkingLot,
            UpdatedAt = DateTimeOffset.UtcNow
        };
        
        await OnAddToParkingLot.InvokeAsync(parkingLotItem);
    }

    private string GetPriorityClass(double? priority)
    {
        return priority switch
        {
            >= 70 => "high-priority",
            >= 40 => "medium-priority",
            _ => "low-priority"
        };
    }

    private string GetTypeBadgeClass(InsightType type)
    {
        return type switch
        {
            InsightType.ActionItem => "bg-danger",
            InsightType.KeyPoint => "bg-primary",
            InsightType.ParkingLot => "bg-warning text-dark",
            InsightType.ResearchResult => "bg-info",
            _ => "bg-secondary"
        };
    }
}